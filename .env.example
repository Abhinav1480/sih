# ORCA Environment Configuration
# Mode: "DEMO" for offline/deterministic competition demo, "LIVE" for real network queries
ORCA_MODE=DEMO

# DEMO only: freeze "now" to an ISO timestamp, so "tomorrow morning" always
# means the same morning and the same cached granules are selected.
#
# The committed ISRO granules cover 1-9 September 2026 and each product has its
# own validity (3 days for a daily scene, 8 for the fluorescence composite).
# Left empty, ORCA uses the wall clock: once those windows pass, the granule
# provider correctly declines and the chain falls to the labelled synthetic
# model, with the trace saying so. That is the honest behaviour, not a bug --
# but it does mean a clone made months later shows no ISRO data.
#
# Set this to see the real granules flow. It changes what time the QUESTION is
# about; processing timestamps (trace steps, generated_at) stay on the real
# clock. See backend/app/utils/clock.py.
ORCA_DEMO_NOW=2026-09-09T06:00:00Z

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Anthropic Claude API (Optional in DEMO mode; required for live Claude reasoning & synthesis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database (Default uses local SQLite with spatial helper; use PostgreSQL+PostGIS for production)
DATABASE_URL=sqlite:///./orca.db
# DATABASE_URL=postgresql://orca_user:orca_password@localhost:5432/orca_db

# External Marine & Weather Providers
# Open-Meteo is open access without key
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# --- ISRO / NRSC sources (provenance tier: ISRO) ---
# Bhuvan WMS requires no credentials and works out of the box.
BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# MOSDAC (INSAT-3D/3DR/3DS) and Bhoonidhi (Oceansat-3 OCM, SCATSAT, SARAL-AltiKa)
# are authentication-gated. Register at mosdac.gov.in and bhoonidhi.nrsc.gov.in.
# Leave blank to run without them: the provider chain skips them and falls back
# to a clearly labelled FALLBACK source rather than mislabelling anything.
MOSDAC_API_TOKEN=
BHOONIDHI_API_TOKEN=

# Pre-fetched ISRO product granules, served offline at query time.
ISRO_GRANULE_CACHE_DIR=./data/granules

# INCOIS Portal Configuration (When live credentials / token available)
INCOIS_API_BASE=https://incois.gov.in/portal
INCOIS_API_TOKEN=

# IMD Mausam Configuration
IMD_API_BASE=https://mausam.imd.gov.in/api

# Mapbox Token (Optional; defaults to OpenStreetMap / CartoDB ocean tiles in Leaflet/MapLibre)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Deployment (Render backend + Vercel frontend; see docs/DEPLOYMENT.md) ---
# Render injects PORT itself; the Dockerfile binds 0.0.0.0:$PORT. Set on Render:
#   ORCA_MODE=DEMO                      (offline, deterministic, no outbound network)
#   DEBUG=False
#   CORS_ORIGINS=http://localhost:3000,https://<your-frontend>.vercel.app
# Set on Vercel (Project -> Settings -> Environment Variables), then redeploy:
#   NEXT_PUBLIC_API_BASE_URL=https://<your-backend>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
