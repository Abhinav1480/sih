# ORCA Frontend Environment Configuration
# API Endpoint for ORCA Multi-Agent Backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Google Maps Platform API Key (Mandatory for interactive cartography)
# Required Google Cloud APIs to enable in Google Cloud Console:
# 1. Maps JavaScript API
# 2. Places API
# 3. Geocoding API (optional for client-side geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
