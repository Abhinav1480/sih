# ORCA Frontend Environment Configuration
# Backend base URL. Leave empty to call the same origin (reverse proxy / Docker).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" to serve deterministic mock responses without a backend.
NEXT_PUBLIC_USE_MOCKS=false

# Google Maps Platform API Key (optional; Leaflet tiles are used when absent)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Deployed backend (Render). When set, web builds default to "deployed" mode; native defaults to local.
NEXT_PUBLIC_DEPLOYED_API_URL=https://orca-backend.onrender.com
